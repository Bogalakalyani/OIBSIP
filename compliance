_read_discrepancy_mapping = gernas.trace_tool(
    "discrepancy_mapping",
    tool_type="api",
    api_operation="read_discrepancy_mapping",
    dependency="compliance_db",               # set to the real store name (e.g. cosmosdb)
    authorization_decision="not_evaluated",
)(read_discrepency_mapping)


def _request_context(event):
    """SOW §2 Identity / Execution context from the event. Raw user id is HMAC-tokenized."""
    return gernas.request_context(
        session_id=event.get("conversation_id"),
        task_id=event.get("chat_id"),
        user_id=event.get("user_id"),
        principal_type="human",
    )


def _correlation_suffix() -> str:
    c = gernas.correlation()
    return f" | agent_run_id={c.get('agent_run_id')} trace_id={c.get('trace_id')}"


class ComplianceAgent():

    def _ok(self, payload: Dict[str, Any]) -> AgentResponse:
        return AgentResponse(agent_run_status=True, agent_response=payload)

    def _fail(self, reason: str) -> AgentResponse:
        return AgentResponse(agent_run_status=False, agent_failure_reason=reason)

    def _get_discrepancy_mapping(self):
        mapping = {str(item['field_id']): str(item['discrepancy_value']) for item in _read_discrepancy_mapping()}
        return mapping

    def _save_json_results(self, data, file_name):
        # NOTE (review F4): writes raw prompts / customer data to disk. Default behaviour is
        # unchanged; set settings.compliance_save_results = False to switch it off.
        if not getattr(settings, "compliance_save_results", True):
            return
        BASE_DIR = Path(__file__).resolve().parent
        DIR = BASE_DIR / "results"
        DIR.mkdir(exist_ok=True, parents=True)
        file_path = DIR / f"{Path(__file__).stem}_{file_name}.json"
        try:
            with open(file_path, 'w', encoding="utf-8") as f:
                json.dump(data, f, indent=4)
        except Exception as e:
            raise

    # -----------------------------------------------------------------------
    # Public entry point - same name, signature and return values as before.
    # Not traced itself: it only converts exceptions into _fail(...), exactly as before.
    # -----------------------------------------------------------------------
    @log_execution_time
    def run(self, conversation_id, event, res_trade_rule, key, field_id):
        """ To generate questions for each document (LC and/or beneficiary) based on the main instructions"""
        with contextlib.ExitStack() as stack:
            try:
                stack.enter_context(_request_context(event))
            except Exception:  # telemetry must never break the agent
                pass
            try:
                return self._run(conversation_id, event, res_trade_rule, key, field_id)
            except Exception as e:
                return self._fail(reason=f"Doc Check Agent Excption Raised. {str(e)}")

    # agent.run span (SOW §2 Agent / Execution / Outcome). Exceptions propagate through it so
    # the span records ERROR + error_category + termination_reason, then run() converts them.
    @trace_lc_agent("lc_compliance", agent_type="worker")
    def _run(self, conversation_id, event, res_trade_rule, key, field_id):
        # SOW §2: no raw event / customer data in logs - only bounded identifiers.
        try:
            logger.info(
                "Compliance Agent started | requested_process=%s field_id=%s%s",
                event.get("requested_process"), field_id, _correlation_suffix(),
            )
            gernas.annotate({Ctx.REQUEST_TYPE: "tbml" if event.get("requested_process") == "tbml" else "lc_compliance"})
        except Exception:
            pass
        try:
            return self._check_rule(conversation_id, event, res_trade_rule, key, field_id)
        except Exception as e:
            logger.exception(f"Doc Check Agent Excption Raised. {e}{_correlation_suffix()}")
            raise

